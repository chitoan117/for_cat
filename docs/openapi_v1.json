{
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ComponentState": {
        "enum": [
          "MOCK",
          "NOT_CONFIGURED",
          "NOT_CONNECTED",
          "NOT_VALIDATED",
          "ONLINE",
          "DEGRADED",
          "OFFLINE",
          "FAULT"
        ],
        "title": "ComponentState",
        "type": "string"
      },
      "Event": {
        "properties": {
          "details": {
            "additionalProperties": true,
            "maxProperties": 16,
            "title": "Details",
            "type": "object"
          },
          "kind": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "maximum": 4294967295.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "state": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "Event",
        "type": "object"
      },
      "FeedResult": {
        "properties": {
          "request_id": {
            "title": "Request Id",
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/FeedState"
          }
        },
        "required": [
          "request_id",
          "state"
        ],
        "title": "FeedResult",
        "type": "object"
      },
      "FeedState": {
        "enum": [
          "REQUEST_RECEIVED",
          "PENDING",
          "SUCCESS",
          "REJECTED",
          "ERROR"
        ],
        "title": "FeedState",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LinkState": {
        "enum": [
          "UNCONFIGURED",
          "CONNECTING",
          "ONLINE",
          "DEGRADED",
          "OFFLINE"
        ],
        "title": "LinkState",
        "type": "string"
      },
      "Status": {
        "properties": {
          "ai": {
            "additionalProperties": true,
            "title": "Ai",
            "type": "object"
          },
          "camera": {
            "$ref": "#/components/schemas/ComponentState",
            "default": "MOCK"
          },
          "esp32": {
            "$ref": "#/components/schemas/ComponentState",
            "default": "MOCK"
          },
          "esp32_online": {
            "title": "Esp32 Online",
            "type": "boolean"
          },
          "feeds": {
            "items": {
              "$ref": "#/components/schemas/FeedResult"
            },
            "title": "Feeds",
            "type": "array"
          },
          "hardware_validation": {
            "const": "HARDWARE_NOT_VALIDATED",
            "default": "HARDWARE_NOT_VALIDATED",
            "title": "Hardware Validation",
            "type": "string"
          },
          "link_state": {
            "$ref": "#/components/schemas/LinkState",
            "default": "UNCONFIGURED"
          },
          "link_stats": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Link Stats",
            "type": "object"
          },
          "observation_service": {
            "additionalProperties": true,
            "title": "Observation Service",
            "type": "object"
          },
          "readiness": {
            "additionalProperties": true,
            "title": "Readiness",
            "type": "object"
          },
          "sensors": {
            "$ref": "#/components/schemas/ComponentState",
            "default": "NOT_CONNECTED"
          },
          "simulated_water": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Simulated Water"
          },
          "software_status": {
            "const": "SOFTWARE_OK",
            "default": "SOFTWARE_OK",
            "title": "Software Status",
            "type": "string"
          }
        },
        "required": [
          "esp32_online",
          "feeds"
        ],
        "title": "Status",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "forr_cat Jetson API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/behavior": {
      "get": {
        "operationId": "behavior_api_v1_behavior_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  },
                  "title": "Response Behavior Api V1 Behavior Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Behavior"
      }
    },
