[Unit]
Description=ForCat existing TensorRT detector with passive C++ SystemState tap
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/for_cat
ExecStart=/bin/bash %h/for_cat/scripts/run_existing_ai.sh
KillMode=control-group
Restart=no
TimeoutStopSec=10
NoNewPrivileges=true
UMask=0077
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
