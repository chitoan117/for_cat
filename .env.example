# Defaults are mock-only. Copy selected values to your shell; never commit secrets.
CAMERA_PROVIDER=MOCK
# USB: discovered /dev/videoX on Jetson, or a Windows OpenCV camera index such as 0.
CAMERA_DEVICE=
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=10
CAMERA_BACKEND=AUTO
# Optional trusted local V4L2→appsink pipeline; no recording sinks permitted.
CAMERA_GSTREAMER_PIPELINE=
CAMERA_READ_TIMEOUT_MS=1000
CAMERA_FAILURE_THRESHOLD=3
VIDEO_REPLAY_PATH=
ESP32_TRANSPORT=MOCK
ESP32_SERIAL_DEVICE=
ESP32_SERIAL_BAUD=115200
SERIAL_RECONNECT_BACKOFF_SECONDS=2
DATABASE_PATH=
EVENT_RETENTION=1000
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=
BEHAVIOR_CONFIRM_FRAMES=2
BEHAVIOR_CONFIRM_SECONDS=0.5
PREFERENCE_MIN_SESSIONS=3
AI_RUNTIME=MOCK
AI_SHADOW_MODE=true
AI_INFERENCE_FPS=2
PROCESSING_MAX_WIDTH=640
PROCESSING_MAX_HEIGHT=480
FRAME_SKIP=1
FRAME_QUEUE_DEPTH=1
MAX_FRAME_AGE_SECONDS=1
# Trusted local root/relative files only; no REST model-path input.
MODEL_ROOT=
IDENTITY_MODEL_PATH=
BEHAVIOR_MODEL_PATH=
DETECTOR_MODEL_PATH=
# Real thresholds remain unconfigured until dataset evaluation; no scientific defaults.
IDENTITY_CONFIDENCE_THRESHOLD=
BEHAVIOR_CONFIDENCE_THRESHOLD=
DETECTOR_CONFIDENCE_THRESHOLD=
# Normalized x1,y1,x2,y2; intentionally unconfigured until camera position is known.
ROI_FOOD_BOWL=
ROI_WATER_BOWL=
ROI_FEEDER_APPROACH=
LOG_LEVEL=INFO
